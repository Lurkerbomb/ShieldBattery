@@ -0,0 +1,603 @@
+#ifndef BWGAME_BWL_HEALTH_H
+#define BWGAME_BWL_HEALTH_H
+
+// Simulation health accounting.
+//
+// OpenBW replays a command stream that a different engine produced, and it can
+// drift from that engine without ever failing. A build order the client could
+// afford is dropped here for want of gas, the tech building is never created,
+// and every command that depended on it is quietly discarded for the rest of
+// the game. Nothing in the normal output says so: the simulation keeps running
+// and its numbers stay plausible.
+//
+// These counters are the two signals that do say so.
+//
+//   - A build order dropped for resources. A human does not issue an order they
+//     cannot afford, so a resource rejection is close to proof that the
+//     simulation has already drifted. It is sharp and it fires early.
+//   - The rate of selection tags that cannot be a real selection. Coarser, but
+//     it grades every replay rather than only the ones that trip the first
+//     signal.
+//
+// Both are cheap enough to leave on: a few increments per action and a bounded
+// log of dropped orders. See native/replay-simulator/README.md in the
+// starcraft-masters repo for what the numbers measured on real replays.
+
+#include <array>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <utility>
+#include <vector>
+
+namespace bwgame {
+namespace health {
+
+enum class tag_verdict {
+	clean,        // a live unit the acting player owns
+	ambiguous,    // another player's unit, in a lone selection - ordinary play
+	foreign,      // another player's unit, where BW's UI could not have put one
+	building,     // a building in a multi-unit selection, likewise impossible
+	dead,         // the slot exists but holds no live unit
+	unallocated,  // past everything this simulation ever created
+};
+
+enum class build_drop {
+	supply,
+	resources,
+};
+
+// The five finite object pools, in the order they are reported.
+enum class pool {
+	units,
+	bullets,
+	sprites,
+	images,
+	orders,
+	count,
+};
+
+inline const char* name_of(pool which) {
+	switch (which) {
+	case pool::units: return "units";
+	case pool::bullets: return "bullets";
+	case pool::sprites: return "sprites";
+	case pool::images: return "images";
+	case pool::orders: return "orders";
+	default: return "unknown";
+	}
+}
+
+/**
+ * How close one pool came to its ceiling, and whether it hit it.
+ *
+ * `grown` is the container's own `size`: slots it has had to bring into
+ * existence, in units of its allocation granularity. It only ever rises, and
+ * the container grows precisely when it is about to run out, so the final value
+ * is the run's high-water mark for concurrent live objects. That makes the
+ * comparison with `capacity` a proof rather than a sample: `top()` returns
+ * nullptr only when the free list is empty *and* `size == capacity`, so a pool
+ * that ends below its capacity cannot have refused anything at any point in the
+ * run.
+ */
+struct pool_usage {
+	size_t grown = 0;
+	size_t capacity = 0;
+	size_t refusals = 0;
+	int first_refusal_frame = -1;
+};
+
+// Damage that no weapon id describes. `weapon_structure_fire` is a damaged
+// Terran building burning down, which is the one lethal damage path in the
+// engine with neither a source unit nor a weapon.
+constexpr int weapon_unknown = -1;
+constexpr int weapon_structure_fire = -2;
+
+struct killer_record {
+	int victim_generation = -1;
+	int killer_index = -1;
+	int killer_unit_type_id = -1;
+	int killer_owner = -1;
+	int weapon_id = weapon_unknown;
+};
+
+/**
+ * Damage inflicted on one player by one weapon over a whole run.
+ *
+ * This is what makes a death whose killer did not survive still explicable, and
+ * what answers "how much did Plague actually do" - a question no death record
+ * can, because Plague by design never lands the killing blow. Amounts are fp8
+ * raw values summed as integers: fp8 has eight
+ * fractional bits, so a total is `raw / 256` hit points, and accumulating the
+ * raw form keeps Irradiate's per-tick fraction exact instead of rounding it 76
+ * times.
+ */
+struct damage_record {
+	long long raw_damage = 0;
+	size_t hits = 0;
+	size_t kills = 0;
+};
+
+// A stable reference to the exact occupant of one unit slot at the time a
+// fact was recorded. The generation is load-bearing: an index alone can name a
+// different unit by the time the end-of-game consumer serializes the ledger.
+struct unit_reference {
+	int index = -1;
+	int generation = -1;
+	int unit_type_id = -1;
+	int owner = -1;
+	int x = -1;
+	int y = -1;
+};
+
+// One discrete technology activation that passed the engine's target, range,
+// visibility, cooldown and energy checks. This is deliberately recorded where
+// energy is spent/effect execution begins, not where the replay command enters.
+struct spell_cast {
+	int frame = -1;
+	int tech_type_id = -1;
+	unit_reference caster;
+	unit_reference target;
+	int target_x = -1;
+	int target_y = -1;
+	int raw_energy_before = 0;
+	int raw_energy_after = 0;
+};
+
+// One application of damage at its engine frame. HP and shield damage remain
+// separate so engagement analysis does not undercount Protoss or confuse a
+// shield-only hit with a lethal one.
+struct damage_application {
+	int frame = -1;
+	int weapon_id = weapon_unknown;
+	unit_reference source;
+	unit_reference victim;
+	long long raw_hit_point_damage = 0;
+	long long raw_shield_damage = 0;
+	bool lethal = false;
+};
+
+struct effect_source_record {
+	int victim_generation = -1;
+	unit_reference source;
+};
+
+enum class resource_kind { minerals, gas };
+
+// Cargo credited to one depot from one resource node. This is the exact
+// economic fact needed to distinguish workers merely standing near a base from
+// a base that is actually producing income.
+struct resource_delivery {
+	int frame = -1;
+	resource_kind kind = resource_kind::minerals;
+	int amount = 0;
+	unit_reference worker;
+	unit_reference depot;
+	unit_reference resource;
+};
+
+struct dropped_build {
+	int frame;
+	int owner;
+	int unit_type_id;
+	build_drop reason;
+	// What the player could afford versus what the order cost, plus lifetime
+	// income. A small shortfall against correct totals means the economy is
+	// merely late; a large one, or correct totals with a low balance, means
+	// resources went somewhere the replay never sent them.
+	int minerals;
+	int gas;
+	int mineral_cost;
+	int gas_cost;
+	int minerals_gathered;
+	int gas_gathered;
+};
+
+struct tag_error {
+	int frame;
+	tag_verdict verdict;
+	// For `unallocated`, how many more unit slots the client had grown than we
+	// had. One is a credible claim that it is a unit ahead of us; a thousand,
+	// two minutes into a game, is not a unit count at all. Zero for the other
+	// verdicts, which carry no such claim.
+	int gap;
+};
+
+// Raw command counts used only to recognize generated replay-integrity
+// signatures. Recording these does not accept, reject or otherwise alter a
+// command. The maps are bounded so a hostile replay cannot grow diagnostics
+// without limit.
+struct command_count {
+	int frame;
+	int owner;
+	size_t count;
+};
+
+struct replay_speed_command {
+	int frame;
+	int owner;
+};
+
+// Above this, an `unallocated` tag is not read as evidence of a unit-count
+// divergence. It is still counted - the rate is what grades the run - but it
+// cannot date the onset.
+//
+// This was introduced to contain tags carrying the raw value 0x2001, which
+// landed around gap 1166 and always arrived before any credible error, so
+// without it the onset was reported thousands of frames early. Those tags are
+// not mysterious any more - they name container index 0, and `scr_tag_index`
+// now resolves them - so the threshold no longer has a known population to
+// exclude. Neither is the generation half, which the 32-bit decode settled. It
+// is kept because it costs nothing and a gap in the thousands is not a unit
+// count under any reading, so it is the last line under a future decode fault.
+constexpr int max_credible_gap = 32;
+
+struct counters {
+	static constexpr size_t max_integrity_command_frames = 4096;
+	static constexpr size_t max_replay_speed_commands = 64;
+	std::vector<replay_speed_command> replay_speed_commands;
+	std::map<std::pair<int, int>, size_t> stay_in_range_commands;
+	std::map<std::pair<int, int>, size_t> cancel_morph_commands;
+	bool integrity_commands_truncated = false;
+
+	// Counted per unit tag rather than per action. Tags whose index is 0
+	// reference no unit and are not counted at all.
+	size_t tags_total = 0;
+	size_t tags_clean = 0;
+	size_t tags_ambiguous = 0;
+	size_t tags_foreign = 0;
+	size_t tags_building = 0;
+	size_t tags_dead = 0;
+	size_t tags_unallocated = 0;
+	int first_definite_error_frame = -1;
+	// First frame at which the client credibly held more units than we did.
+	int first_unit_deficit_frame = -1;
+
+	// A rate says a replay is bad; the onset says when it went bad, and whether
+	// it went bad all at once or drifted. Bounded for the same reason as the
+	// dropped build orders below.
+	static constexpr size_t max_logged_tag_errors = 32;
+	std::vector<tag_error> first_tag_errors;
+
+	// Building placements, counted where an accepted build order survives
+	// can_place_building and reaches place_building. Landing a lifted building
+	// and the two Nydus/CTF special cases return before the affordability
+	// checks and are not counted either way.
+	size_t builds_placed = 0;
+	// How close a successful placement came to failing. Humans issue orders the
+	// instant they can afford them, so a healthy run should still show
+	// placements with almost no margin - that is the player's doing, not ours.
+	size_t builds_tight = 0;
+	// Ways a unit the replay asked for never gets created. These are silent in
+	// the engine: action_build ignores a placement the map rejects and still
+	// returns true, and action_train gives up when the selection it needs is not
+	// there. Unlike a build order refused for cost, the client validated both
+	// before sending, so either one means our world already differs from its.
+	size_t place_rejected = 0;      // can_place_building said no
+	size_t train_no_selection = 0;  // nothing selected, or not ours
+	size_t train_cannot_build = 0;  // selected unit cannot produce the type
+	size_t train_queue_full = 0;    // five already queued
+	size_t train_unaffordable = 0;  // supply or resources, as with a building
+	int first_place_rejected_frame = -1;
+	int first_train_lost_frame = -1;
+	// Kept apart from the others: a train command the replay issued while we had
+	// nothing valid selected is the only one of these that never happens in a
+	// healthy run, so it is the only one whose timing is worth comparing against
+	// the tag onset.
+	int first_train_no_selection_frame = -1;  // placed with under 16 of a resource it spends
+	int min_mineral_margin = -1;
+	int min_gas_margin = -1;
+	size_t builds_dropped_supply = 0;
+	size_t builds_dropped_resources = 0;
+	int first_dropped_build_frame = -1;
+
+	// Bounded. The first drops are what locate a divergence, and a replay that
+	// has diverged can produce hundreds of them.
+	static constexpr size_t max_logged_drops = 64;
+	std::vector<dropped_build> dropped_builds;
+
+	std::array<pool_usage, (size_t)pool::count> pools{};
+
+	// Keyed by weapon id and victim owner, so it is bounded by the weapon table
+	// rather than by the number of blows struck.
+	std::map<std::pair<int, int>, damage_record> damage;
+	std::vector<damage_application> damage_applications;
+	std::vector<resource_delivery> resource_deliveries;
+	std::vector<spell_cast> spell_casts;
+	// Delayed effects such as Plague apply damage without retaining a live
+	// caster pointer. Keyed by weapon and victim slot, with generation checked
+	// on lookup so a reused slot cannot inherit the previous occupant's caster.
+	std::map<std::pair<int, int>, effect_source_record> effect_sources;
+	// OpenBW clears a bullet's owner pointer when the caster dies before impact.
+	// Bullet slots have no generation, but the reference is consumed only while
+	// the bullet is active and every new occupant overwrites its slot.
+	std::map<size_t, unit_reference> bullet_sources;
+
+	// One entry per slot that has ever held a unit killed by damage, so it is
+	// bounded by the unit pool rather than by the number of deaths.
+	std::map<int, killer_record> killers;
+};
+
+inline counters& get() {
+	static counters instance;
+	return instance;
+}
+
+inline void reset() {
+	get() = counters();
+}
+
+inline void record_replay_speed_command(int frame, int owner) {
+	counters& c = get();
+	if (c.replay_speed_commands.size() >= counters::max_replay_speed_commands) {
+		c.integrity_commands_truncated = true;
+		return;
+	}
+	c.replay_speed_commands.push_back({frame, owner});
+}
+
+inline void record_integrity_command(std::map<std::pair<int, int>, size_t>& commands,
+									 int frame, int owner) {
+	auto found = commands.find({frame, owner});
+	if (found != commands.end()) {
+		++found->second;
+		return;
+	}
+	if (commands.size() >= counters::max_integrity_command_frames) {
+		get().integrity_commands_truncated = true;
+		return;
+	}
+	commands[{frame, owner}] = 1;
+}
+
+inline void record_stay_in_range_command(int frame, int owner) {
+	record_integrity_command(get().stay_in_range_commands, frame, owner);
+}
+
+inline void record_cancel_morph_command(int frame, int owner) {
+	record_integrity_command(get().cancel_morph_commands, frame, owner);
+}
+
+// Who dealt the lethal damage, held from the kill until the consumer's
+// destroy callback runs in the same frame. Keyed by the victim's slot and
+// generation together: a slot is reused within a game, and without the
+// generation a fresh unit could read its predecessor's killer.
+inline void record_killer(int victim_index, int victim_generation,
+                          int killer_index, int killer_unit_type_id, int killer_owner,
+                          int weapon_id) {
+	killer_record& record = get().killers[victim_index];
+	record = { victim_generation, killer_index, killer_unit_type_id, killer_owner, weapon_id };
+}
+
+// Every damage application. Called from the one funnel every damaging path
+// goes through, so nothing can remove HP or shields without entering the
+// temporal ledger and its whole-game aggregate.
+inline void record_damage(int frame, int weapon_id, const unit_reference& source,
+                          const unit_reference& victim, long long raw_hit_point_damage,
+                          long long raw_shield_damage, bool lethal) {
+	counters& c = get();
+	damage_record& record = c.damage[{ weapon_id, victim.owner }];
+	record.raw_damage += raw_hit_point_damage + raw_shield_damage;
+	++record.hits;
+	if (lethal) ++record.kills;
+	c.damage_applications.push_back(damage_application{
+		frame, weapon_id, source, victim, raw_hit_point_damage, raw_shield_damage, lethal
+	});
+}
+
+inline void record_effect_source(int weapon_id, const unit_reference& victim,
+                                 const unit_reference& source) {
+	if (victim.index < 0 || victim.generation < 0) return;
+	get().effect_sources[{weapon_id, victim.index}] = {victim.generation, source};
+}
+
+inline unit_reference effect_source_of(int weapon_id, int victim_index, int victim_generation) {
+	const auto found = get().effect_sources.find({weapon_id, victim_index});
+	if (found == get().effect_sources.end() || found->second.victim_generation != victim_generation) return {};
+	return found->second.source;
+}
+
+inline void record_bullet_source(size_t bullet_index, const unit_reference& source) {
+	get().bullet_sources[bullet_index] = source;
+}
+
+inline unit_reference bullet_source_of(size_t bullet_index) {
+	const auto found = get().bullet_sources.find(bullet_index);
+	return found == get().bullet_sources.end() ? unit_reference{} : found->second;
+}
+
+inline void record_resource_delivery(int frame, resource_kind kind, int amount,
+                                     const unit_reference& worker, const unit_reference& depot,
+                                     const unit_reference& resource) {
+	get().resource_deliveries.push_back(resource_delivery{frame, kind, amount, worker, depot, resource});
+}
+
+inline void record_spell_cast(int frame, int tech_type_id, const unit_reference& caster,
+                              const unit_reference& target, int target_x, int target_y,
+                              int raw_energy_before, int raw_energy_after) {
+	get().spell_casts.push_back(spell_cast{
+		frame, tech_type_id, caster, target, target_x, target_y,
+		raw_energy_before, raw_energy_after
+	});
+}
+
+// The killer of this exact unit, or a record with `killer_index < 0` when the
+// damage had no source unit - Plague, Irradiate, Scarab splash after its owner
+// is gone, and scripted damage all reach a unit with nothing to name.
+inline killer_record killer_of(int victim_index, int victim_generation) {
+	const counters& c = get();
+	auto found = c.killers.find(victim_index);
+	if (found == c.killers.end() || found->second.victim_generation != victim_generation) return {};
+	return found->second;
+}
+
+// Called once per frame per pool. `grown` and `refusals` are both monotonic, so
+// overwriting each frame keeps the run's final high-water mark; only the first
+// refusal frame needs latching.
+inline void record_pool(pool which, int frame, size_t grown, size_t capacity, size_t refusals) {
+	pool_usage& usage = get().pools[(size_t)which];
+	usage.grown = grown;
+	usage.capacity = capacity;
+	if (refusals > usage.refusals && usage.first_refusal_frame < 0) usage.first_refusal_frame = frame;
+	usage.refusals = refusals;
+}
+
+// A tag that resolves to nothing, to a unit the acting player does not own in a
+// selection that could not have contained one, or to a building in a
+// multi-unit selection, is a resolution BW itself could not have produced.
+inline bool is_definite_error(tag_verdict verdict) {
+	return verdict == tag_verdict::foreign
+		|| verdict == tag_verdict::building
+		|| verdict == tag_verdict::dead
+		|| verdict == tag_verdict::unallocated;
+}
+
+inline void record_tag(int frame, tag_verdict verdict, int gap = 0) {
+	counters& c = get();
+	++c.tags_total;
+	switch (verdict) {
+	case tag_verdict::clean: ++c.tags_clean; break;
+	case tag_verdict::ambiguous: ++c.tags_ambiguous; break;
+	case tag_verdict::foreign: ++c.tags_foreign; break;
+	case tag_verdict::building: ++c.tags_building; break;
+	case tag_verdict::dead: ++c.tags_dead; break;
+	case tag_verdict::unallocated: ++c.tags_unallocated; break;
+	}
+	if (is_definite_error(verdict)) {
+		if (c.first_definite_error_frame < 0) c.first_definite_error_frame = frame;
+		// Only an `unallocated` tag claims a unit count, and only a small gap
+		// makes that claim believable. `foreign` and `dead` have a noise floor -
+		// a healthy 28865-frame replay produces three - so they grade a run but
+		// cannot date one.
+		if (verdict == tag_verdict::unallocated && gap <= max_credible_gap) {
+			if (c.first_unit_deficit_frame < 0) c.first_unit_deficit_frame = frame;
+		}
+		if (c.first_tag_errors.size() < counters::max_logged_tag_errors) {
+			c.first_tag_errors.push_back(tag_error{frame, verdict, gap});
+		}
+	}
+}
+
+inline const char* name_of(tag_verdict verdict) {
+	switch (verdict) {
+	case tag_verdict::clean: return "clean";
+	case tag_verdict::ambiguous: return "ambiguous";
+	case tag_verdict::foreign: return "foreign";
+	case tag_verdict::building: return "building";
+	case tag_verdict::dead: return "dead";
+	case tag_verdict::unallocated: return "unallocated";
+	}
+	return "unknown";
+}
+
+// Every Remastered unit tag as it arrives, off unless BWL_TAG_TRACE is set.
+// This is the instrument that decoded the generation half: `tagGen` is what the
+// replay's 32-bit tag carries and `ourGen` is what OpenBW's own counter holds
+// for that slot at the same instant, so the two can be fitted against each
+// other over a whole corpus rather than guessed from one game. They agreed on
+// all 168232 live tags in the sixty-replay corpus.
+//
+//   [tag] f<frame> raw=<hex> slot=<n> tagGen=<n> index=<n> ourGen=<n> <verdict>
+inline void dump_tag(int frame, unsigned raw, size_t slot, unsigned tag_generation,
+                     size_t index, int our_generation, const char* verdict) {
+	static const bool enabled = std::getenv("BWL_TAG_TRACE") != nullptr;
+	if (!enabled) return;
+	std::printf("[tag] f%d raw=%08x slot=%zu tagGen=%u index=%zd ourGen=%d %s\n",
+		frame, raw, slot, tag_generation, (ptrdiff_t)index, our_generation, verdict);
+}
+
+// Per-unit state for comparison against the real client, off unless
+// BWL_UNIT_DUMP is set. This is the instrument that located the first
+// divergence: unit counts only move on a birth or a death, long after the two
+// engines part company, but a position moves every frame.
+//
+// One line per frame on stdout, the simulator's own output going to --output:
+//
+//   [units] f<frame> <index>,<type>,<owner>,<x>,<y>,<order> ...
+//
+// `index` is the container index. See tools/compare-units.py for how that maps
+// onto the client's unit ids.
+//
+// Both the visible and the hidden list are walked. A unit in production is
+// created when training starts and lives on the hidden list until it completes,
+// exactly as in the client, whose capture walks the per-player unit lists and so
+// sees it throughout. Dumping only the visible list makes the simulation look
+// like it allocates late, which it does not.
+template<typename units_T>
+inline void dump_units_range(units_T&& units) {
+	for (auto* u : units) {
+		if (!u->unit_type) continue;
+		std::printf(" %zu,%d,%d,%d,%d,%d", (size_t)u->index, (int)u->unit_type->id, u->owner,
+			u->sprite ? u->sprite->position.x : -1, u->sprite ? u->sprite->position.y : -1,
+			u->order_type ? (int)u->order_type->id : -1);
+	}
+}
+
+template<typename units_T, typename hidden_T>
+inline void dump_units(int frame, units_T&& units, hidden_T&& hidden) {
+	static const bool enabled = std::getenv("BWL_UNIT_DUMP") != nullptr;
+	if (!enabled) return;
+	std::printf("[units] f%d", frame);
+	dump_units_range(units);
+	dump_units_range(hidden);
+	std::printf("\n");
+}
+
+inline void record_place_rejected(int frame) {
+	counters& c = get();
+	++c.place_rejected;
+	if (c.first_place_rejected_frame < 0) c.first_place_rejected_frame = frame;
+}
+
+enum class train_loss { no_selection, cannot_build, queue_full, unaffordable };
+
+inline void record_train_lost(int frame, train_loss reason) {
+	counters& c = get();
+	switch (reason) {
+	case train_loss::no_selection:
+		++c.train_no_selection;
+		if (c.first_train_no_selection_frame < 0) c.first_train_no_selection_frame = frame;
+		break;
+	case train_loss::cannot_build: ++c.train_cannot_build; break;
+	case train_loss::queue_full: ++c.train_queue_full; break;
+	case train_loss::unaffordable: ++c.train_unaffordable; break;
+	}
+	if (c.first_train_lost_frame < 0) c.first_train_lost_frame = frame;
+}
+
+inline void record_build_placed(int mineral_margin, int gas_margin,
+                                bool costs_minerals, bool costs_gas) {
+	counters& c = get();
+	++c.builds_placed;
+	// Only a resource the order actually spends says anything about timing.
+	// A depot costs no gas, so its gas margin is just the player's balance.
+	bool tight = false;
+	if (costs_minerals) {
+		if (c.min_mineral_margin < 0 || mineral_margin < c.min_mineral_margin) c.min_mineral_margin = mineral_margin;
+		if (mineral_margin < 16) tight = true;
+	}
+	if (costs_gas) {
+		if (c.min_gas_margin < 0 || gas_margin < c.min_gas_margin) c.min_gas_margin = gas_margin;
+		if (gas_margin < 16) tight = true;
+	}
+	if (tight) ++c.builds_tight;
+}
+
+inline void record_build_dropped(int frame, int owner, int unit_type_id, build_drop reason,
+                                 int minerals, int gas, int mineral_cost, int gas_cost,
+                                 int minerals_gathered, int gas_gathered) {
+	counters& c = get();
+	if (reason == build_drop::supply) ++c.builds_dropped_supply;
+	else ++c.builds_dropped_resources;
+	if (c.first_dropped_build_frame < 0) c.first_dropped_build_frame = frame;
+	if (c.dropped_builds.size() < counters::max_logged_drops) {
+		c.dropped_builds.push_back(dropped_build{frame, owner, unit_type_id, reason,
+			minerals, gas, mineral_cost, gas_cost, minerals_gathered, gas_gathered});
+	}
+}
+
+}
+}
+
+#endif
diff --git a/data_loading.h b/data_loading.h
index c8d5a0f..963626a 100644
--- a/data_loading.h
+++ b/data_loading.h
@@ -9,6 +9,7 @@
 #include <array>
 #include <cstring>
 #include <cstdio>
+#include <cstdlib>
 
 namespace bwgame {
 namespace data_loading {
@@ -1299,12 +1300,53 @@ struct mpq_file {
 template<typename mpq_file_T = mpq_file<>>
 struct data_files_loader {
 	a_list<mpq_file_T> mpqs;
+	a_vector<a_string> override_dirs;
 
 	void add_mpq_file(a_string filename) {
 		mpqs.emplace_back(std::move(filename));
 	}
 
+	// A directory of loose files that wins over every archive.
+	//
+	// Remastered keeps its data in CASC rather than in MPQs, so files taken
+	// from a Remastered install cannot be added with add_mpq_file. This exists
+	// for the tilesets in particular: the classic ones in StarDat.mpq define
+	// far fewer tile groups than current ladder maps index (1513 for Space
+	// Platform against the 2045 a map like KnockOut 1.4 uses), and every tile
+	// past the end is silently dropped by load_map_data, which punches holes
+	// through the terrain and breaks pathing. The Remastered files parse as
+	// classic cv5/vf4 - same 52 and 32 byte records - so they can simply be
+	// dropped in front.
+	void add_override_directory(a_string path) {
+		if (!path.empty() && path[path.size() - 1] != '/' && path[path.size() - 1] != '\\') path += '/';
+		override_dirs.push_back(std::move(path));
+	}
+
+	static bool read_loose_file(const a_string& path, a_vector<uint8_t>& dst) {
+		FILE* f = fopen(path.c_str(), "rb");
+		if (!f) return false;
+		if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return false; }
+		long len = ftell(f);
+		if (len < 0 || fseek(f, 0, SEEK_SET) != 0) { fclose(f); return false; }
+		dst.resize((size_t)len);
+		bool ok = len == 0 || fread(dst.data(), 1, (size_t)len, f) == (size_t)len;
+		fclose(f);
+		return ok;
+	}
+
 	void operator()(a_vector<uint8_t>& dst, a_string filename) {
+		if (!override_dirs.empty()) {
+			// Requests use MPQ-style paths ("Tileset/platform.cv5"); accept
+			// both that layout and a flat directory of extracted files.
+			a_string rel = filename;
