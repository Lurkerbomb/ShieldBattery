+	// StarCraft: Remastered (1.21+) reissued the selection and targeting
+	// actions under new ids (0x60-0x65) and pads every unit tag with a
+	// trailing uint16. The fields are otherwise identical to the classic
+	// actions, so these read the padding and delegate.
+	//
+	// The tags also count from a different base. Remastered's unit pool holds
+	// 3400 slots to OpenBW's 1700 and both hand them out descending, so the slot
+	// a tag names sits exactly 1700 above the container index of the same unit -
+	// and since that is the container's own capacity, taking the +1 off the tag
+	// leaves a plain modulus.
+	//
+	// Fitted against a whole game rather than assumed: each right-click action
+	// carries both a tag and the pixel clicked, so the unit meant is whichever
+	// one's footprint contains the click, whatever the encoding. Over 302 such
+	// pairs the slot ran 1701 above the index for 229 of them and the rest were
+	// near-misses on clustered mineral patches - except one group, every click
+	// on the geyser at index 0, which fixes the wrap.
+	//
+	// This replaces a fixed bias of 348, which was the same arithmetic truncated
+	// to 11 bits (2048 - 1701 = 347, plus one for the tag). The two agree for
+	// every slot at or above 2048 and part company below it, where the map's
+	// first neutral units live - the geyser among them. A tag that missed sent a
+	// right-click through with no target at all, which degrades in BW to a plain
+	// Move to the clicked pixel: the worker walks to the geyser and stands there
+	// instead of gathering.
+	//
+	// A Remastered tag is one 32-bit little-endian word, not a uint16 followed by
+	// padding. The reader consumes both halves either way, so treating the second
+	// as filler parses every replay correctly and hides what it carries: the
+	// generation continues into it.
+	//
+	//   bits 0-12   slot, 1-based, in the 3400-entry pool
+	//   bits 13-31  generation, exactly BW's own per-slot counter
+	//
+	// The high word is zero for a generation under 8, which is 99.94% of tags in
+	// the corpus, so it reads as padding until a slot is reused eight times. Over
+	// 60 replays the full word decodes OpenBW's `unit_id_generation` exactly -
+	// 168232 of 168232 live tags, generations 1 through 12, no modulus and no
+	// offset. The earlier reading of "5 for a freshly allocated slot, the two
+	// counters a multiple of 4 apart" was measured while the slot decode was
+	// still wrong, so it was comparing generations of different units.
+	static const uint32_t scr_tag_slot_mask = 0x1fff;
+	static const unsigned scr_tag_generation_shift = 13;
+
+	// The container index a Remastered tag names, or size_t(-1) for no unit.
+	size_t scr_tag_index(uint32_t raw) const {
+		size_t slot = raw & scr_tag_slot_mask;
+		if (!slot) return (size_t)-1;
+		return (slot - 1) % st.units_container.capacity;
+	}
+
+	unsigned scr_tag_generation(uint32_t raw) const {
+		return raw >> scr_tag_generation_shift;
+	}
+
+	// A tag names an occupant of a slot, not the slot. Once a slot is reused the
+	// old tag must resolve to nothing, or a command issued at the unit that died
+	// lands on whatever took its place. BW does this with the generation counter
+	// and so, now, do we.
+	bool scr_tag_is_current(uint32_t raw, const unit_t* u) const {
+		return u && u->unit_id_generation == scr_tag_generation(raw);
+	}
+
+	unit_t* get_unit_121(uint32_t raw) const {
+		size_t index = scr_tag_index(raw);
+		if (index == (size_t)-1) return nullptr;
+		unit_t* u = get_unit(index);
+		return scr_tag_is_current(raw, u) ? u : nullptr;
+	}
+
+	// Judge a tag against what actually occupies the slot it names, which is
+	// more than get_unit_121 can say: it returns null both for a unit that died
+	// and for a slot this simulation never allocated, and those mean very
+	// different things. A dead slot is a small timing disagreement. An
+	// unallocated one is proof that the client had a unit here and we never
+	// built it.
+	//
+	// Owning the unit is not the test. Selecting an enemy or a mineral patch is
+	// ordinary play, and in a mirror matchup it is common. What BW's UI cannot
+	// do is put a foreign unit in a selection of two or more, put any building
+	// in one, or apply shift-select or deselect to anything but a selection that
+	// is already all own units. A tag that lands outside those rules is a
+	// resolution the client could not have produced.
+	health::tag_verdict classify_scr_tag(int owner, uint32_t raw, bool multi, bool owned_context, int& gap) const {
+		size_t external = scr_tag_index(raw);
+		const unit_t* u = st.units_container.try_get(external);
+		if (!u) {
+			// Slots are handed out with descending external index, so the
+			// lowest one grown so far is the frontier. How far past it this tag
+			// reaches is how many more units the client must have allocated.
+			size_t frontier = st.units_container.capacity - st.units_container.size;
+			gap = (int)((ptrdiff_t)frontier - (ptrdiff_t)external + 1);
+			return health::tag_verdict::unallocated;
+		}
+		// A stale tag names a unit that is gone as surely as a dead one does, and
+		// for the same reason: the client is a few frames ahead of what the
+		// player saw. No corpus tag reaches this, so it is a guard rather than a
+		// measured population.
+		if (!scr_tag_is_current(raw, u)) return health::tag_verdict::dead;
+		if (!u->unit_type || unit_dead(u)) return health::tag_verdict::dead;
+		if (u->owner != owner) {
+			if (multi || owned_context) return health::tag_verdict::foreign;
+			return health::tag_verdict::ambiguous;
+		}
+		if (multi && ut_building(u)) return health::tag_verdict::building;
+		return health::tag_verdict::clean;
+	}
+
+	void record_scr_tag(int owner, uint32_t raw, bool multi, bool owned_context) const {
+		if (scr_tag_index(raw) == (size_t)-1) return;
+		int gap = 0;
+		health::tag_verdict verdict = classify_scr_tag(owner, raw, multi, owned_context, gap);
+		health::record_tag(st.current_frame, verdict, gap);
+		size_t index = scr_tag_index(raw);
+		const unit_t* u = st.units_container.try_get(index);
+		health::dump_tag(st.current_frame, raw, raw & scr_tag_slot_mask, scr_tag_generation(raw),
+			index, u ? (int)u->unit_id_generation : -1, health::name_of(verdict));
+	}
+
+	// One 32-bit tag out of two little-endian halves. Read as two statements
+	// because the order of two reads inside one expression is unspecified.
+	template<typename reader_T>
+	uint32_t read_scr_tag(reader_T&& r) const {
+		uint32_t low = r.template get<uint16_t>();
+		uint32_t high = r.template get<uint16_t>();
+		return low | (high << 16);
+	}
+
+	template<typename reader_T>
+	bool read_action_select_121(int owner, reader_T&& r) {
+		size_t n = r.template get<uint8_t>();
+		if (n > 12) error("invalid selection of %d units", n);
+		static_vector<unit_t*, 12> units;
+		for (size_t i = 0; i != n; ++i) {
+			uint32_t raw = read_scr_tag(r);
+			record_scr_tag(owner, raw, n > 1, false);
+			units.push_back(get_unit_121(raw));
+		}
+		return action_select(owner, units);
+	}
+
+	template<typename reader_T>
+	bool read_action_shift_select_121(int owner, reader_T&& r) {
+		size_t n = r.template get<uint8_t>();
+		if (n > 12) error("invalid selection of %d units", n);
+		static_vector<unit_t*, 12> units;
+		for (size_t i = 0; i != n; ++i) {
+			uint32_t raw = read_scr_tag(r);
+			record_scr_tag(owner, raw, n > 1, true);
+			units.push_back(get_unit_121(raw));
+		}
+		return action_shift_select(owner, units);
+	}
+
